# ------------------------------------------------------------
# Manual 2048 demo widget (cleaner / dark-theme friendly)
# ------------------------------------------------------------

import ipywidgets as widgets
from IPython.display import display


def launch_manual_2048_demo(seed=None, target=2048):
    rng = random.Random(seed) if seed is not None else random.Random()
    env = Game2048Env(target=target, rng=rng)

    title_html = widgets.HTML(
        """
        <div style="
            font-size:20px;
            font-weight:700;
            color:#f5f5f5;
            margin:0 0 8px 0;
            font-family:Arial,sans-serif;
        ">
            Manual 2048 Demo
        </div>
        """
    )

    status_html = widgets.HTML()
    board_html = widgets.HTML()
    message_html = widgets.HTML()

    btn_up = widgets.Button(
        description="Up",
        layout=widgets.Layout(width="90px", height="40px"),
        button_style=""
    )
    btn_left = widgets.Button(
        description="Left",
        layout=widgets.Layout(width="90px", height="40px"),
        button_style=""
    )
    btn_down = widgets.Button(
        description="Down",
        layout=widgets.Layout(width="90px", height="40px"),
        button_style=""
    )
    btn_right = widgets.Button(
        description="Right",
        layout=widgets.Layout(width="90px", height="40px"),
        button_style=""
    )
    btn_reset = widgets.Button(
        description="New Game",
        layout=widgets.Layout(width="120px", height="40px"),
        button_style="info"
    )

    def render():
        legal_moves = env.get_legal_moves() if not env.done else []

        btn_left.disabled = "left" not in legal_moves
        btn_right.disabled = "right" not in legal_moves
        btn_up.disabled = "up" not in legal_moves
        btn_down.disabled = "down" not in legal_moves

        score = env.get_score()
        move_count = env.get_move_count()
        max_tile = env.get_max_tile()
        won = env.won
        done = env.done

        legal_moves_text = ", ".join(legal_moves) if legal_moves else "none"

        status_html.value = f"""
        <div style="
            background:#1f2430;
            border:1px solid #3b4252;
            border-radius:10px;
            padding:12px 14px;
            color:#f5f5f5;
            font-family:Arial,sans-serif;
            line-height:1.7;
            min-width:320px;
        ">
            <div><b>Score:</b> {score}</div>
            <div><b>Moves:</b> {move_count}</div>
            <div><b>Max Tile:</b> {max_tile}</div>
            <div><b>Won:</b> {won}</div>
            <div><b>Done:</b> {done}</div>
            <div><b>Legal Moves:</b> {legal_moves_text}</div>
        </div>
        """

        board_html.value = render_board_html_from_bitboard(env.board)

    def set_message(text, color):
        message_html.value = f"""
        <div style="
            margin-top:8px;
            color:{color};
            font-family:Arial,sans-serif;
            font-size:14px;
            min-height:20px;
        ">
            {text}
        </div>
        """

    def do_move(action):
        if env.done:
            set_message("<b>Game over.</b> Press New Game to start again.", "#ff6b6b")
            render()
            return

        legal_moves = env.get_legal_moves()
        if action not in legal_moves:
            set_message(f"Move <b>{action}</b> is not legal in this state.", "#ff6b6b")
            render()
            return

        _, reward, done, info = env.step_bitboard(action, include_legal_moves=False)

        if done:
            set_message(
                f"<b>Game over.</b> Last move: <b>{action}</b>, reward: <b>{reward}</b>.",
                "#ff6b6b",
            )
        else:
            set_message(
                f"Last move: <b>{action}</b>, reward: <b>{reward}</b>.",
                "#8bd49c",
            )

        render()

    def on_up(_):
        do_move("up")

    def on_left(_):
        do_move("left")

    def on_down(_):
        do_move("down")

    def on_right(_):
        do_move("right")

    def on_reset(_):
        env.reset()
        set_message("Started a new game.", "#7ec8ff")
        render()

    btn_up.on_click(on_up)
    btn_left.on_click(on_left)
    btn_down.on_click(on_down)
    btn_right.on_click(on_right)
    btn_reset.on_click(on_reset)

    controls = widgets.VBox([
        widgets.HBox(
            [widgets.HTML("<div style='width:90px;'></div>"), btn_up, widgets.HTML("<div style='width:90px;'></div>")],
            layout=widgets.Layout(justify_content="center")
        ),
        widgets.HBox(
            [btn_left, btn_down, btn_right],
            layout=widgets.Layout(justify_content="center", gap="8px")
        ),
        widgets.HBox(
            [btn_reset],
            layout=widgets.Layout(justify_content="center")
        ),
    ], layout=widgets.Layout(gap="8px"))

    left_panel = widgets.VBox(
        [board_html, controls],
        layout=widgets.Layout(align_items="center", gap="12px")
    )

    main_row = widgets.HBox(
        [left_panel, status_html],
        layout=widgets.Layout(
            align_items="flex-start",
            gap="20px",
            flex_flow="row wrap"
        )
    )

    container = widgets.VBox(
        [title_html, main_row, message_html],
        layout=widgets.Layout(gap="10px")
    )

    set_message("Started a new game.", "#7ec8ff")
    render()
    display(container)


# Run this to launch the demo
launch_manual_2048_demo()